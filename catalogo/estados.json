{
  "version": 1,
  "estados": {
    "nuevo": {
      "nombre": "New",
      "etapa": "pendiente",
      "descripcion": "Just created, not yet reviewed or prioritised."
    },
    "pendiente": {
      "nombre": "Backlog",
      "etapa": "pendiente",
      "descripcion": "Ready or prioritised, not started."
    },
    "en_curso": {
      "nombre": "In progress",
      "etapa": "curso",
      "descripcion": "Someone is working on it."
    },
    "bloqueado": {
      "nombre": "Blocked",
      "etapa": "espera",
      "descripcion": "Stopped by something the team does not control. Returns after a block do not count as rework."
    },
    "en_revision": {
      "nombre": "Review",
      "etapa": "espera",
      "descripcion": "Waiting for review or approval."
    },
    "en_pruebas": {
      "nombre": "Testing",
      "etapa": "espera",
      "descripcion": "Waiting for or going through testing and validation."
    },
    "en_espera": {
      "nombre": "Waiting",
      "etapa": "espera",
      "descripcion": "Waiting for something or someone: deployment, an answer, another team."
    },
    "terminado": {
      "nombre": "Done",
      "etapa": "hecho",
      "descripcion": "Delivered."
    },
    "descartado": {
      "nombre": "Discarded",
      "etapa": "hecho",
      "descripcion": "Closed without doing it: duplicate, will not do, obsolete. Does not count as a delivery."
    }
  },
  "reglas": [
    {
      "estado": "terminado",
      "patron": "\\b(done|hecho|hecha|finaliz|cerrad|closed|resolved|resuelt|complet|terminad|released|deployed|shipped|verified|desplegad|entregad)|\\blisto\\b(?!\\s*para)"
    },
    {
      "estado": "descartado",
      "patron": "\\bremoved\\b"
    },
    {
      "estado": "pendiente",
      "patron": "(selected for|seleccionad[oa]s? para|ready for (dev|develop)|listo para (el )?desarroll|\\bcommitted\\b|\\bapproved\\b|\\bproposed\\b)"
    },
    {
      "estado": "bloqueado",
      "patron": "(block|bloq|imped|hold|pausa)"
    },
    {
      "estado": "en_revision",
      "patron": "(review|revis|aprobac|approval|authoriz)"
    },
    {
      "estado": "en_pruebas",
      "patron": "(\\bqa\\b|test|prueba|valid|\\buat\\b|quality assurance|acceptance|aceptacion)"
    },
    {
      "estado": "pendiente",
      "patron": "(clarif|aclara)",
      "categoria": "(to do|todo|por hacer|\\bnew\\b|nuev|open|abiert|backlog)"
    },
    {
      "estado": "en_espera",
      "patron": "(clarif|aclara)"
    },
    {
      "estado": "pendiente",
      "patron": "(\\bqueued?\\b|\\bcola\\b)",
      "categoria": "(to do|todo|por hacer|\\bnew\\b|nuev|open|abiert|backlog)"
    },
    {
      "estado": "en_espera",
      "patron": "(\\bqueued?\\b|\\bcola\\b)"
    },
    {
      "estado": "en_espera",
      "patron": "(wait|esper|ready for|listo para|por desplegar|to deploy|staging|scheduled)"
    },
    {
      "estado": "en_curso",
      "patron": "(progress|curso|progreso|doing|desarroll|develop|haciendo|implement|working|trabaj|in dev|coding|\\bactive\\b)"
    },
    {
      "estado": "nuevo",
      "patron": "(backlog|open|abiert|nuev|\\bnew\\b|\\bdraft\\b)"
    },
    {
      "estado": "pendiente",
      "patron": "(to do|todo|por hacer|pendiente|ready|selected|seleccionad|refin|analis|analys|assess)"
    },
    {
      "estado": "descartado",
      "patron": "(cancel|descart|rechaz|won.?t|obsolet|duplicad|duplicat|invalid|declin)",
      "categoria": "(done|hecho|finaliz|complet|\\blisto\\b)"
    }
  ],
  "porCategoria": [
    {
      "patron": "(done|hecho|finaliz|complet|\\blisto\\b)",
      "estado": "terminado"
    },
    {
      "patron": "(progress|curso|progreso|indeterminate)",
      "estado": "en_curso"
    },
    {
      "patron": "(to do|todo|por hacer|\\bnew\\b|nuev|open|abiert|backlog)",
      "estado": "pendiente"
    }
  ],
  "porDefecto": "pendiente"
}
