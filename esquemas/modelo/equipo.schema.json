{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-performance/esquemas/modelo/equipo.schema.json",
  "title": "Equipo",
  "description": "Un equipo, interno o de un proveedor. Se mide contra su propia historia. El FTE indica de dónde sale el dato.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nombre", "tipo", "proveedor", "area", "usa_sprints", "fte", "limites"],
  "properties": {
    "id": { "$ref": "comun.schema.json#/$defs/id" },
    "nombre": { "type": "string", "minLength": 1 },
    "tipo": { "enum": ["interno", "proveedor"] },
    "proveedor": { "type": ["string", "null"] },
    "area": { "type": ["string", "null"] },
    "usa_sprints": { "type": "boolean" },
    "fte": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["periodo", "valor", "origen"],
        "properties": {
          "periodo": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "Mes, en formato AAAA-MM." },
          "valor": { "type": "number", "exclusiveMinimum": 0 },
          "origen": { "enum": ["contrato", "declarado", "estimado"] }
        }
      }
    },
    "limites": { "$ref": "comun.schema.json#/$defs/limitesPorMedida" }
  },
  "if": { "properties": { "tipo": { "const": "proveedor" } } },
  "then": { "properties": { "proveedor": { "type": "string", "minLength": 1 } } },
  "else": { "properties": { "proveedor": { "type": "null" } } }
}
