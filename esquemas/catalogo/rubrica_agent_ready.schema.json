{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-performance/esquemas/catalogo/rubrica_agent_ready.schema.json",
  "title": "Rúbrica de agent readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "definicion",
    "listoDesde",
    "criterios"
  ],
  "$defs": {
    "patrones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patron"
        ],
        "properties": {
          "patron": {
            "type": "string",
            "minLength": 1
          },
          "flags": {
            "type": "string",
            "pattern": "^[ims]*$"
          },
          "sobreOriginal": {
            "type": "boolean",
            "description": "Se aplica sobre el texto original (con mayúsculas y acentos) y no sobre el normalizado."
          }
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "definicion": {
      "type": "string",
      "minLength": 1
    },
    "listoDesde": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "criterios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contenido",
        "criterios",
        "acotado",
        "referencias",
        "sinDependencias"
      ],
      "properties": {
        "contenido": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nombre",
            "como",
            "minimoPalabras"
          ],
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "como": {
              "type": "string",
              "minLength": 1
            },
            "minimoPalabras": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "criterios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nombre",
            "como",
            "patrones"
          ],
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "como": {
              "type": "string",
              "minLength": 1
            },
            "patrones": {
              "$ref": "#/$defs/patrones"
            }
          }
        },
        "acotado": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nombre",
            "como",
            "maximoEstimacion",
            "maximoDias"
          ],
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "como": {
              "type": "string",
              "minLength": 1
            },
            "maximoEstimacion": {
              "type": "number"
            },
            "maximoDias": {
              "type": "number"
            }
          }
        },
        "referencias": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nombre",
            "como",
            "patrones"
          ],
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "como": {
              "type": "string",
              "minLength": 1
            },
            "patrones": {
              "$ref": "#/$defs/patrones"
            }
          }
        },
        "sinDependencias": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nombre",
            "como",
            "patrones"
          ],
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "como": {
              "type": "string",
              "minLength": 1
            },
            "patrones": {
              "$ref": "#/$defs/patrones"
            }
          }
        }
      }
    }
  }
}
